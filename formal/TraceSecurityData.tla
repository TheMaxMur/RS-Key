        pinSet |-> TRUE,
        persistentGrant |-> FALSE ]
      [] i = 47 -> [ live |-> FALSE,
        permissionMc |-> FALSE,
        permissionGa |-> FALSE,
        permissionCm |-> FALSE,
        permissionAcfg |-> FALSE,
        rpBound |-> FALSE,
        pinSet |-> FALSE,
        persistentGrant |-> FALSE ]
      [] i = 49 -> [ live |-> FALSE,
        permissionMc |-> FALSE,
        permissionGa |-> FALSE,
        permissionCm |-> FALSE,
        permissionAcfg |-> FALSE,
        rpBound |-> FALSE,
        pinSet |-> FALSE,
        persistentGrant |-> FALSE ]
      [] OTHER -> CHOOSE x : FALSE

BoundaryOutcomeRaw(i) ==
    CASE i = 5 -> "Authorized"
      [] i = 6 -> "Authorized"
      [] i = 13 -> "Authorized"
      [] i = 14 -> "Authorized"
      [] i = 21 -> "Authorized"
      [] i = 22 -> "Authorized"
      [] i = 27 -> "Authorized"
      [] i = 33 -> "Authorized"
      [] i = 34 -> "Authorized"
      [] OTHER -> CHOOSE x : FALSE

BoundaryOutcomeB(i) ==
    CASE i = 5 -> "Authorized"
      [] i = 6 -> "Authorized"
      [] i = 13 -> "Authorized"
      [] i = 14 -> "Authorized"
      [] i = 21 -> "Authorized"
      [] i = 22 -> "Authorized"
      [] i = 27 -> "Authorized"
      [] i = 33 -> "Authorized"
      [] i = 34 -> "Authorized"
      [] OTHER -> CHOOSE x : FALSE

GateKind(i) ==
    CASE i = 29 -> "mc"
      [] i = 30 -> "mc"
      [] i = 49 -> "reset"
      [] OTHER -> CHOOSE x : FALSE

GateRk(i) ==
    CASE i = 29 -> TRUE
      [] i = 30 -> FALSE
      [] i = 49 -> FALSE
      [] OTHER -> CHOOSE x : FALSE

GateOutcomeRaw(i) ==
    CASE i = 29 -> "Rejected"
      [] i = 30 -> "Authorized"
      [] i = 49 -> "Rejected"
      [] OTHER -> CHOOSE x : FALSE

TraceAction(i) ==
    CASE i = 0 -> TraceStutter
      [] i = 1 -> TraceStutter
      [] i = 2 -> SetPinStart
      [] i = 3 -> SetPinClearPpuat
      [] i = 4 -> SetPinWrite
      [] i = 5 -> GetPinToken({"mc", "ga"}, NoRp)
      [] i = 6 -> RegisterStart("rp1", Fido)
      [] i = 7 -> PressDown
      [] i = 8 -> /\ TouchConfirm /\ pres'.pressing = TRUE
      [] i = 9 -> RegisterTouched
      [] i = 10 -> RegisterWriteA
      [] i = 11 -> RegisterWriteB
      [] i = 12 -> PressUp
      [] i = 13 -> GetPinToken({"mc", "ga"}, NoRp)
      [] i = 14 -> RegisterStart("rp1", Fido)
      [] i = 15 -> PressDown
      [] i = 16 -> /\ TouchConfirm /\ pres'.pressing = TRUE
      [] i = 17 -> RegisterTouched
      [] i = 18 -> RegisterWriteA
      [] i = 19 -> RegisterWriteB
      [] i = 20 -> PressUp
      [] i = 21 -> GetPinToken({"mc", "ga"}, NoRp)
      [] i = 22 -> AssertStart("rp1", Fido)
      [] i = 23 -> PressDown
      [] i = 24 -> /\ TouchConfirm /\ pres'.pressing = TRUE
      [] i = 25 -> AssertFinish
      [] i = 26 -> PressUp
      [] i = 27 -> TraceStutter
      [] i = 28 -> TraceStutter
      [] i = 29 -> TraceStutter
      [] i = 30 -> TraceStutter
      [] i = 31 -> TraceStutter
      [] i = 32 -> GetPinToken({"mc", "ga"}, NoRp)
      [] i = 33 -> GetPinToken({"mc", "ga"}, NoRp)
      [] i = 34 -> WrongPin
      [] i = 35 -> TraceStutter
      [] i = 36 -> PowerCut
      [] i = 37 -> ResetStart
      [] i = 38 -> PressDown
      [] i = 39 -> /\ TouchConfirm /\ pres'.pressing = TRUE
      [] i = 40 -> ResetConfirmed
      [] i = 41 -> ResetSweepSecrets
      [] i = 42 -> ResetSweepSecrets
      [] i = 43 -> ResetSweepGates
      [] i = 44 -> ResetSweepGates
      [] i = 45 -> ResetFinish
      [] i = 46 -> PressUp
      [] i = 47 -> Tick
      [] i = 48 -> TraceStutter
      [] OTHER -> CHOOSE x : FALSE

