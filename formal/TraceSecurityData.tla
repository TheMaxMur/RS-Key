GateKind(i) ==
    CASE i = 11 -> "mc"
      [] i = 13 -> "mc"
      [] i = 43 -> "mc"
      [] i = 44 -> "mc"
      [] i = 50 -> "mc"
      [] i = 51 -> "mc"
      [] i = 74 -> "reset"
      [] OTHER -> CHOOSE x : FALSE

GateRk(i) ==
    CASE i = 11 -> TRUE
      [] i = 13 -> FALSE
      [] i = 43 -> TRUE
      [] i = 44 -> FALSE
      [] i = 50 -> FALSE
      [] i = 51 -> TRUE
      [] i = 74 -> FALSE
      [] OTHER -> CHOOSE x : FALSE

GateOutcomeRaw(i) ==
    CASE i = 11 -> "Authorized"
      [] i = 13 -> "Authorized"
      [] i = 43 -> "Rejected"
      [] i = 44 -> "Authorized"
      [] i = 50 -> "Rejected"
      [] i = 51 -> "Rejected"
      [] i = 74 -> "Rejected"
      [] OTHER -> CHOOSE x : FALSE

TraceAction(i) ==
    CASE i = 0 -> TraceStutter
      [] i = 1 -> TraceStutter
      [] i = 2 -> RegisterStart("rp1", Fido)
      [] i = 3 -> PressDown
      [] i = 4 -> /\ TouchConfirm /\ pres'.pressing = TRUE
      [] i = 5 -> RegisterTouched
      [] i = 6 -> RegisterWriteA
      [] i = 7 -> RegisterWriteB
      [] i = 8 -> PressUp
      [] i = 9 -> TraceStutter
      [] i = 10 -> TraceStutter
      [] i = 11 -> TraceStutter
      [] i = 12 -> TraceStutter
      [] i = 13 -> TraceStutter
      [] i = 14 -> TraceStutter
      [] i = 15 -> TraceStutter
      [] i = 16 -> SetPinStart
      [] i = 17 -> SetPinClearPpuat
      [] i = 18 -> SetPinWrite
      [] i = 19 -> GetPinToken({"mc", "ga"}, NoRp)
      [] i = 20 -> RegisterStart("rp1", Fido)
      [] i = 21 -> PressDown
