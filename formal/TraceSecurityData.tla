      [] i = 19 -> "Authorized"
      [] i = 20 -> "Authorized"
      [] i = 27 -> "Authorized"
      [] i = 28 -> "Authorized"
      [] i = 35 -> "Authorized"
      [] i = 36 -> "Authorized"
      [] i = 41 -> "Authorized"
      [] i = 47 -> "Authorized"
      [] i = 48 -> "Authorized"
      [] i = 53 -> "Authorized"
      [] i = 54 -> "Authorized"
      [] i = 58 -> "Authorized"
      [] OTHER -> CHOOSE x : FALSE

