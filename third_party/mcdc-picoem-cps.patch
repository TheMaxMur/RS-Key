+
+#[test]
+fn mcdc_cps_i_f_bits_change_only_the_requested_mask_in_each_security_state() {
+    for secure in [false,true] {
+        let (mut cpu,mut bus)=machine(0xb672);
+        if secure {cpu.transition_to_secure();}
+        cpu.regs.set_pc(NS_CODE);
+        cpu.regs.primask=0;cpu.regs.faultmask=0;
+        for (index,(opcode,primask,faultmask)) in [(0xb672,1,0),(0xb662,0,0),(0xb671,0,1),(0xb661,0,0)].into_iter().enumerate() {
+            let pc=NS_CODE+2*index as u32;bus.write16(pc,opcode,0);cpu.step(&mut bus);
+            assert_eq!(cpu.regs.pc(),pc+2,"secure={secure},opcode={opcode:04x}");
+            assert_eq!(cpu.regs.primask,primask,"secure={secure},opcode={opcode:04x}");
+            assert_eq!(cpu.regs.faultmask,faultmask,"secure={secure},opcode={opcode:04x}");
+            assert_eq!(cpu.regs.ipsr(),0);
+        }
+    }
+}
