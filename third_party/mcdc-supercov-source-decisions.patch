 fn is_logical(expression: &ast::Expr) -> bool {
     matches!(expression, ast::Expr::BinExpr(binary)
         if matches!(binary.op_kind(), Some(BinaryOp::LogicOp(LogicOp::And | LogicOp::Or))))
