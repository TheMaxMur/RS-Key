+// SPDX-License-Identifier: AGPL-3.0-only
+// Copyright (C) 2026 RS-Key contributors
+
+use supercov_engine::rust_instrumenter::{instrument_rust_file, instrument_rust_source, TargetCfg};
+
+#[test]
+fn let_else_is_one_explicit_pattern_decision() {
+    let source = "pub fn f(v: Option<u8>) -> u8 { let Some(n) = v else { return 0; }; n }";
+    let result = instrument_rust_source("src/lib.rs", source, "crate::runtime").unwrap();
+    let decision = result.manifest.decisions.iter().find(|d| d.kind == "let-else").unwrap();
+    assert_eq!(decision.source, "let Some(n) = v");
+    assert_eq!(decision.conditions, ["let Some(n) = v"]);
+    assert!(result.code.contains("::condition(false,"));
+    assert!(result.code.contains("::condition(true,"));
+}
+
+#[test]
+fn disabled_first_macro_cannot_hide_a_later_active_site() {
+    let source = "#[cfg(any())] dead!();\npub fn f() { opaque!(if a && b {}); }\n";
+    let cfg = TargetCfg::new(&[]).for_build(false, false, Default::default());
+    let result = instrument_rust_file("src/lib.rs", source, "crate::runtime", false, Some(&cfg)).unwrap();
+    assert!(result.manifest.limitations.iter().any(|row|
+        row["line"] == 2 && row["reason"].as_str().unwrap().contains("opaque")));
+}
+
+#[test]
+fn disabled_first_const_cannot_hide_a_later_compile_time_decision() {
+    let source = "#[cfg(any())] const DEAD: u8 = if true {1} else {0};\nstatic LIVE: u8 = if true {1} else {0};\n";
+    let cfg = TargetCfg::new(&[]).for_build(false, false, Default::default());
+    let result = instrument_rust_file("src/lib.rs", source, "crate::runtime", false, Some(&cfg)).unwrap();
+    assert!(result.manifest.limitations.iter().any(|row| row["line"] == 2));
+    assert_eq!(result.manifest.decisions.len(), 1);
+    assert!(result.manifest.unmeasured.contains(&result.manifest.decisions[0].id));
+}
+
+#[test]
+fn guarded_matches_has_one_aggregate_and_one_guard() {
+    let source = "pub fn f(v:Option<(bool,bool)>)->bool { matches!(v,Some((a,b)) if a && b) }";
+    let result = instrument_rust_source("src/lib.rs", source, "crate::runtime").unwrap();
+    let mut kinds = result.manifest.decisions.iter().map(|d| d.kind.as_str()).collect::<Vec<_>>();
+    kinds.sort();
+    assert_eq!(kinds, ["matches", "matches-guard"]);
+    let guard = result.manifest.decisions.iter().find(|d| d.kind == "matches-guard").unwrap();
+    assert_eq!(guard.conditions, ["a", "b"]);
+}
+
+#[test]
+fn a_static_function_pointer_body_runs_after_initialization() {
+    let source = "pub static F:fn(bool)->u8=|v| if v {1} else {0};";
+    let result = instrument_rust_source("src/lib.rs", source, "crate::runtime").unwrap();
+    assert_eq!(result.manifest.decisions.len(), 1);
+    assert!(!result.manifest.unmeasured.contains(&result.manifest.decisions[0].id));
+    assert!(result.code.contains("::condition((v)"));
+}
+
+#[test]
+fn debug_assertions_follow_the_build_cfg() {
+    let source = "pub fn f(v:u8) { debug_assert_eq!(v,3); debug_assert!(v>0); }";
+    for enabled in [false, true] {
+        let cfg = TargetCfg::new(&[]).for_build(false, enabled, Default::default());
+        let result = instrument_rust_file("src/lib.rs", source, "crate::runtime", false, Some(&cfg)).unwrap();
+        assert_eq!(result.manifest.decisions.len(), if enabled {2} else {0});
+    }
+}
+
+#[test]
+fn an_owned_index_find_takes_data_instead_of_a_predicate() {
+    let source = "pub fn f(index: &Index, key: u16) -> Option<Entry> { index.find(key) }";
+    let result = instrument_rust_source("src/lib.rs", source, "crate::runtime").unwrap();
+    assert!(result.manifest.decisions.is_empty());
+    assert!(result.code.contains("index.find(key)"));
+}
