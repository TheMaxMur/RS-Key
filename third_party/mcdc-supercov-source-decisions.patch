+fn outside_selection(range: TextRange) -> bool {
+    std::env::var("SUPERCOV_RSK_BYTE_RANGES").ok().is_some_and(|selection| {
+        let start = usize::from(range.start());
+        let end = usize::from(range.end());
+        !selection.split(',').any(|entry| {
+            let (low, high) = entry.split_once(':').expect("laboratory range needs start:end");
+            let low: usize = low.parse().expect("laboratory range start");
+            let high: usize = high.parse().expect("laboratory range end");
+            assert!(low < high, "laboratory range must be nonempty");
+            low <= start && end <= high
+        })
+    })
 }
 
