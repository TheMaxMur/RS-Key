+fn instrument_let_else(
+    insertions: &mut Vec<Insertion>,
+    runtime_path: &str,
+    file: &str,
+    statement: &ast::LetStmt,
+) {
+    let Some(range) = let_else_range(statement) else { return };
+    if outside_selection(range) || in_const_context(statement.syntax()) || in_global_allocator(statement.syntax()) {
+        return;
+    }
+    let block = statement.let_else().and_then(|otherwise| otherwise.block_expr())
+        .expect("a parsed let-else has its diverging block");
+    let ordinal = decision_ordinal(&stable_id(file, "decision", range, "let-else"));
+    let probe = |outcome| format!(
+        "{{ let mut __supercov_let_else_frame = {runtime_path}::DecisionFrame::new({ordinal}, 1); \
+         let __supercov_let_else_value = {runtime_path}::condition({outcome}, &mut __supercov_let_else_frame, 0); \
+         {runtime_path}::decision(__supercov_let_else_value, &mut __supercov_let_else_frame); }}"
+    );
+    // Neither the initializer nor its bindings move into another scope.
+    push_direct(insertions, block_entry(&block), probe(false));
+    let gate = cfg_predicate(statement.syntax())
+        .map_or_else(String::new, |predicate| format!("#[cfg({predicate})] "));
+    push_direct(insertions, usize::from(statement.syntax().text_range().end()),
+        format!(" {gate}{}", probe(true)));
 }
 
