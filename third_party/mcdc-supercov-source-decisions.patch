+fn instrument_comparison_assertion(
+    insertions: &mut Vec<Insertion>, runtime_path: &str, file: &str,
+    call: &ast::CallExpr, left: &ast::Expr, kind: &str,
+    identifiers: &mut BTreeSet<String>,
+) {
+    if cannot_carry_probe(call.syntax()) { return; }
+    let id = stable_id(file, "decision", call.syntax().text_range(), kind);
+    let ordinal = decision_ordinal(&id);
+    let base = format!("__SupercovComparison{}", id.rsplit(':').next().unwrap().to_ascii_uppercase());
+    let mut helper = base.clone();
+    let mut attempt = 0;
+    while !identifiers.insert(helper.clone()) {
+        attempt += 1;
+        helper = format!("{base}_{attempt}");
+    }
+    let outcome = if kind == "assert-ne" { "!value" } else { "value" };
+    let prefix = format!(r#"{{
+        struct __SupercovComparison<'a, L: ?Sized>(&'a L);
+        impl<L: ?Sized, R: ?Sized> core::cmp::PartialEq<R> for __SupercovComparison<'_, L>
+        where L: core::cmp::PartialEq<R> {{
+            fn eq(&self, other: &R) -> bool {{
+                let value = <L as core::cmp::PartialEq<R>>::eq(self.0, other);
+                let mut frame = {runtime_path}::DecisionFrame::new({ordinal}, 1);
+                let outcome = {runtime_path}::condition({outcome}, &mut frame, 0);
+                {runtime_path}::decision(outcome, &mut frame);
+                value
+            }}
+        }}
+        impl<L: ?Sized + core::fmt::Debug> core::fmt::Debug for __SupercovComparison<'_, L> {{
+            fn fmt(&self, formatter: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {{
+                core::fmt::Debug::fmt(self.0, formatter)
+            }}
+        }}
+        "#);
+    push_wrapper(insertions, call.syntax().text_range(), call.syntax().text_range(), 0,
+        prefix.replace('\n', " ").replace("__SupercovComparison", &helper), " }".into());
+    push_wrapper(insertions, left.syntax().text_range(), left.syntax().text_range(), 1,
+        format!("{helper}(&("), "))".into());
+}
