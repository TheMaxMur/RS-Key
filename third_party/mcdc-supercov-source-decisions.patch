+fn matches_guards(root: &ra_ap_syntax::SyntaxNode, matches: &[TextRange]) -> Vec<ast::Expr> {
+    root.descendants().filter_map(ast::CallExpr::cast)
+        .filter(|call| matches.contains(&call.syntax().text_range()))
+        .filter_map(|call| call.arg_list()?.args().nth(1)).collect()
+}
+
+fn comparison_assertions(root: &ra_ap_syntax::SyntaxNode, source: &str) -> Vec<(ast::CallExpr, ast::Expr, &'static str)> {
+    root.descendants().filter_map(ast::CallExpr::cast).filter_map(|call| {
+        let end = usize::from(call.expr()?.syntax().text_range().end());
+        if source.get(end.checked_sub(1)?..end)? != "!" { return None; }
+        let name = call.expr()?.syntax().text().to_string();
+        let kind = match name.rsplit("::").next()? {
+            "assert_eq_" | "debug_assert_eq_" => "assert-eq",
+            "assert_ne_" | "debug_assert_ne_" => "assert-ne",
+            _ => return None,
+        };
+        let left = call.arg_list()?.args().next()?;
+        Some((call, left, kind))
+    }).collect()
+}
+
+fn predicate_callbacks(root: &ra_ap_syntax::SyntaxNode) -> Vec<ast::Expr> {
+    root.descendants().filter_map(ast::MethodCallExpr::cast).filter_map(|call| {
+        let closure = predicate_argument(&call)?;
+        let ast::Expr::ClosureExpr(closure) = closure else { return None; };
+        let body = closure.body()?;
+        if predicate_has_value_decision(&body) { return None; }
+        Some(body)
+    }).collect()
+}
+
+fn predicate_argument(call: &ast::MethodCallExpr) -> Option<ast::Expr> {
+        let name = call.name_ref()?.text().to_string();
+        if !matches!(name.as_str(), "any" | "all" | "is_some_and" | "is_none_or"
+            | "is_ok_and" | "is_err_and" | "filter" | "find" | "position"
+            | "rposition" | "take_while" | "skip_while" | "retain") { return None; }
+        let args = call.arg_list()?.args().collect::<Vec<_>>();
+        if args.len() != 1 { return None; }
+        args.into_iter().next()
+}
+
+fn predicate_functions(root: &ra_ap_syntax::SyntaxNode) -> Vec<ast::Expr> {
+    root.descendants().filter_map(ast::MethodCallExpr::cast)
+        .filter_map(|call| {
+            let argument = predicate_argument(&call)?;
+            let ast::Expr::PathExpr(path) = &argument else { return None; };
+            // RS-Key's owned index `find(key)` takes data, not a callback.
+            if call.name_ref()?.text() == "find" && path.path()?.qualifier().is_none() {
+                return None;
+            }
+            Some(argument)
+        }).collect()
+}
+
+fn predicate_has_value_decision(body: &ast::Expr) -> bool {
+    match unparenthesized(body) {
+        ast::Expr::PrefixExpr(prefix) if prefix.op_kind() == Some(ast::UnaryOp::Not) =>
+            prefix.expr().is_some_and(|body| predicate_has_value_decision(&body)),
+        ast::Expr::BlockExpr(block) => block.stmt_list().and_then(|list| list.tail_expr())
+            .is_some_and(|body| predicate_has_value_decision(&body))
+            && predicate_return_values(body).is_empty(),
+        body => is_logical(&body),
+    }
+}
+
+fn predicate_return_values(body: &ast::Expr) -> Vec<ast::Expr> {
+    body.syntax().descendants().filter_map(ast::ReturnExpr::cast)
+        .filter(|returned| returned.syntax().ancestors()
+            .take_while(|node| node != body.syntax()).skip(1)
+            .all(|node| !ast::Fn::can_cast(node.kind()) && !ast::ClosureExpr::can_cast(node.kind())
+                && !ast::BlockExpr::cast(node).is_some_and(|block| block.async_token().is_some())))
+        .filter_map(|returned| returned.expr()).collect()
 }
 
