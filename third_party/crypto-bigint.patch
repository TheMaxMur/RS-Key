+++ b/Cargo.toml
@@ -47,7 +47,7 @@
     "mathematics",
     "no-std",
 ]
-license = "Apache-2.0 OR MIT"
+license = "AGPL-3.0-only AND (Apache-2.0 OR MIT)"
 repository = "https://github.com/RustCrypto/crypto-bigint"
 resolver = "3"
 
--- a/src/uint/sub.rs
+++ b/src/uint/sub.rs
