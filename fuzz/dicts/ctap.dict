# CTAP2 / CBOR tokens for the FIDO targets (fido_*, pinproto) and the CTAPHID
# framing tokens for the transport targets (ctaphid*, ctaphid_roundtrip).
# Values are copies of named constants in crates/rsk-fido and crates/rsk-usb —
# a new CTAP command byte or authenticator parameter key belongs here too.

# --- CTAP2 command bytes (crates/rsk-fido/src/consts.rs) ---
cmd_mc="\x01"
cmd_ga="\x02"
cmd_info="\x04"
cmd_pin="\x06"
cmd_reset="\x07"
cmd_gna="\x08"
cmd_cm="\x0a"
cmd_sel="\x0b"
cmd_lb="\x0c"
cmd_cfg="\x0d"
cmd_vendor="\x41"

# --- CTAPHID report headers: CID ‖ cmd ‖ be16(len) (crates/rsk-usb/src/ctaphid.rs) ---
cid_broadcast="\xff\xff\xff\xff"
cid_zero="\x00\x00\x00\x00"
hid_init_ping="\xff\xff\xff\xff\x81\x00\x00"
hid_init_msg="\xff\xff\xff\xff\x83\x00\x00"
hid_init_init="\xff\xff\xff\xff\x86\x00\x08"
hid_init_cbor="\xff\xff\xff\xff\x90\x00\x00"
hid_init_cancel="\xff\xff\xff\xff\x91\x00\x00"
hid_init_wink="\xff\xff\xff\xff\x88\x00\x00"
hid_cont="\xff\xff\xff\xff\x00\x00\x00"

