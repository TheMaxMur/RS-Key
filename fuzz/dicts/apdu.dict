# ISO-7816 APDU tokens for the applet replay targets (cross_applet, *_apdu) and
# the TLV parsers. Every value is a copy of a named constant under
# crates/rsk-*/src — a new INS, AID or tag belongs here too.
#
# A token prefixed with a length byte fits `apdu_frame`'s [len][apdu…] framing,
# so one splice plants a whole command rather than a header a mutator must finish.
# libFuzzer caps a token at 64 bytes; the longest here is the PIV SELECT.

# --- selection ---
sel_openpgp="\x0b\x00\xa4\x04\x00\x06\xd2\x76\x00\x01\x24\x01"
sel_mgmt="\x0d\x00\xa4\x04\x00\x08\xa0\x00\x00\x05\x27\x47\x11\x17"
sel_oath="\x0c\x00\xa4\x04\x00\x07\xa0\x00\x00\x05\x27\x21\x01"
sel_otp="\x0c\x00\xa4\x04\x00\x07\xa0\x00\x00\x05\x27\x20\x01"
sel_piv="\x10\x00\xa4\x04\x00\x0b\xa0\x00\x00\x03\x08\x00\x00\x10\x00\x01\x00"
hdr_select="\x00\xa4\x04\x00"
hdr_select_p2_04="\x00\xa4\x04\x04"
hdr_mf="\x00\xa4\x00\x0c"
aid_openpgp="\xd2\x76\x00\x01\x24\x01"
aid_mgmt="\xa0\x00\x00\x05\x27\x47\x11\x17"
aid_oath="\xa0\x00\x00\x05\x27\x21\x01"
aid_otp="\xa0\x00\x00\x05\x27\x20\x01"
aid_piv="\xa0\x00\x00\x03\x08\x00\x00\x10\x00\x01\x00"

