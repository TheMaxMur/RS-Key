#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-only
# Copyright (C) 2026 RS-Key contributors

# Fast pre-commit gate. Run the full suite with ./scripts/check.sh (or in CI).
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks not found — commit from inside 'nix develop'." >&2
    exit 1
fi

# Secret detection over the staged diff only.
gitleaks protect --staged --redact --no-banner

# Formatting + lint gate on the workspace (libs + firmware, no test targets).
cargo fmt --all --check
# `BOARD` because rsk-wipe's build script refuses to guess a flash size — it
# bakes the erase length in, and an under-sized wiper leaves sealed secrets on
# the chip. `waveshare-one` is the reference board (same values as every
# default). scripts/check.sh does the same, and builds it for every board.
cargo clippy --workspace --exclude firmware --exclude firmware-ns --exclude rsk-wipe -- -D warnings
# The two worlds select incompatible critical-section state types. NS also
# needs the Secure-generated layout and gateway import library before linting.
bash scripts/build.sh
tz_out="${RSK_TZ_OUT:-${CARGO_TARGET_DIR:-$PWD/target}/trustzone}"
tz_out=$(cd "$tz_out" && pwd)
export RSK_TZ_IMPLIB="$tz_out/ns-import.a"
export RSK_TZ_NS_MEMORY="$tz_out/nonsecure-memory.x"
export RSK_TZ_SECURE_MEMORY="$tz_out/secure-memory.x"
export RSK_TZ_STAGE=import
BOARD=waveshare-one cargo clippy -p firmware -p rsk-wipe -- -D warnings # roster: scoped
cargo clippy -p firmware-ns -- -D warnings # roster: scoped

# Advisory, never fatal: which users of a redefined constant this commit leaves
# unread. Nothing above can catch that class — the value still type-checks and a
# test written for the old one still passes — so it is reported, not judged, at
# the moment the change is being called done.
python3 "$(git rev-parse --show-toplevel)/scripts/impact.py" || true
